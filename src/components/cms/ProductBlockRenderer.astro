---
import TextBlock from './blocks/TextBlock.astro';
import FeatureGridBlock from './blocks/FeatureGridBlock.astro';
import SpecificationsBlock from './blocks/SpecificationsBlock.astro';
import type { ProductBlock } from '@lib/cms/product-models';

export interface Props {
  blocks: ProductBlock[];
}
const { blocks } = Astro.props;
---

{
  blocks.map(block => {
    switch (block.type) {
      case 'text':
        return <TextBlock heading={block.heading} body={block.body} />;
      case 'feature-grid':
        return <FeatureGridBlock heading={block.heading} items={block.items} />;
      case 'specifications':
        return (
          <SpecificationsBlock heading={block.heading} rows={block.rows} />
        );
      default:
        return null;
    }
  })
}
