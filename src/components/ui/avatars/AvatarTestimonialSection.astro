---
import UnifiedImage from '@components/ui/media/UnifiedImage.astro';

const { src, alt } = Astro.props;

interface Props {
  src: string;
  alt: string;
}
---

<div class="shrink-0">
  <UnifiedImage
    class="size-8 rounded-full sm:h-[2.875rem] sm:w-[2.875rem]"
    src={src}
    alt={alt}
    loading="lazy"
  />
</div>
