---
import { getImage } from 'astro:assets';
import { OG } from '@data/constants';
import faviconSvgSrc from '@images/icon.svg';
import faviconSrc from '@images/icon.png';
import type { BrandViewModel } from '@lib/cms/brand-models';
import type { SiteViewModel } from '@lib/cms/models';
import type { LocaleViewModel } from '@lib/cms/locale-models';
import type { SEOConfig } from '@lib/cms/seo-models';
import { resolveGlobalSeo } from '@lib/cms/seo';
import { buildHreflangTags } from '@lib/i18n/routes';

interface Props {
  meta?: string;
  structuredData?: Record<string, unknown>;
  customDescription?: string | null;
  customOgTitle?: string | null;
  brand?: BrandViewModel;
  site?: SiteViewModel;
  locales?: LocaleViewModel[];
  currentLocale?: string;
  pageContentAvailability?: Record<string, boolean>;
}

const {
  meta,
  structuredData,
  customDescription = null,
  customOgTitle = null,
  brand,
  site,
  locales,
  currentLocale = 'en',
  pageContentAvailability,
} = Astro.props;

const pageSeo: Partial<SEOConfig> = {
  title: customOgTitle || undefined,
  description: customDescription || meta || undefined,
};
const runtime = brand && site ? { brand, site } : undefined;
const resolvedSeo = resolveGlobalSeo(pageSeo, runtime);

const description = resolvedSeo.description;
const ogTitle = resolvedSeo.title;
const ogDescription = resolvedSeo.description;

const siteDomain = site?.domain ? site.domain.replace(/\/+$/, '') : null;
const author = brand?.name || site?.name || '';
const canonical = siteDomain
  ? siteDomain + Astro.url.pathname
  : new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;
const basePath = Astro.url.pathname;
const socialImageRes = await getImage({
  src: OG.image,
  width: 1200,
  height: 600,
});
const socialImage = Astro.url.origin + socialImageRes.src;

// Build alternates config for hreflang tags
const alternatesConfig = {
  siteUrl: siteDomain || String(Astro.url.origin).replace(/\/+$/, ''),
  currentPath: Astro.url.pathname,
  currentLocale: currentLocale || 'en',
  enabledLocales: locales ? getEnabledLocalesFromLocales(locales) : ['en'],
  contentAvailability:
    pageContentAvailability || getDefaultContentAvailability(locales),
};

// Helper function inline in frontmatter
function getEnabledLocalesFromLocales(
  localesList: LocaleViewModel[]
): string[] {
  return localesList.filter(l => l.enabled).map(l => l.code);
}

function getDefaultContentAvailability(
  localesList: LocaleViewModel[] | undefined
): Record<string, boolean> {
  if (!localesList) return { en: true, fr: true };
  const avail: Record<string, boolean> = {};
  for (const loc of localesList) {
    if (loc.enabled && (loc.code === 'en' || loc.code === 'fr')) {
      avail[loc.code] = true;
    } else {
      avail[loc.code] = false;
    }
  }
  return avail;
}

const hreflangTags = buildHreflangTags(alternatesConfig);

const dynamicStructuredData =
  brand && site
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        inLanguage: currentLocale || 'en',
        '@id': site.domain,
        url: site.domain,
        name: brand.name,
        description: brand.seo.description || '',
        isPartOf: {
          '@type': 'WebSite',
          url: site.domain,
          name: brand.name,
          description: brand.seo.description || '',
        },
      }
    : undefined;

const faviconSvg = await getImage({
  src: faviconSvgSrc,
  format: 'svg',
});

const appleTouchIcon = await getImage({
  src: faviconSrc,
  width: 180,
  height: 180,
  format: 'png',
});
---

{
  /*  Inject structured data into the page if provided. This data is formatted as JSON-LD, a method recommended by Google for structured data pass:
     https://developers.google.com/search/docs/advanced/structured-data/intro-structured-data */
}{
  (dynamicStructuredData || structuredData) && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(dynamicStructuredData || structuredData)}
    />
  )
}
{/* Define the character set, description, author, and viewport settings */}
<meta charset="utf-8" />
<meta content={description} name="description" />
<meta name="web_author" content={author} />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="ie=edge" />
<link rel="canonical" href={canonical} />
{
  hreflangTags.map(({ lang, href }) => (
    <link rel="alternate" hreflang={lang} href={href} />
  ))
}

{/* Facebook Meta Tags */}
<meta
  property="og:locale"
  content={currentLocale === 'fr'
    ? 'fr_FR'
    : currentLocale === 'en'
      ? 'en_US'
      : currentLocale}
/>
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle} />
<meta property="og:site_name" content={brand?.name || site?.name || ''} />
<meta property="og:description" content={ogDescription} />
<meta property="og:image" content={socialImage} />
<meta content="1200" property="og:image:width" />
<meta content="600" property="og:image:height" />
<meta content="image/png" property="og:image:type" />

{/* Twitter Meta Tags */}
<meta name="twitter:card" content="summary_large_image" />
<meta
  property="twitter:domain"
  content={site?.domain
    ? new URL(site.domain).hostname
    : (Astro.site?.hostname ?? 'example.com')}
/>
<meta property="twitter:url" content={canonical} />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={socialImage} />

{/* Links to the webmanifest and sitemap */}
<link rel="manifest" href="/manifest.json" />
{/* https://docs.astro.build/en/guides/integrations-guide/sitemap/ */}
<link rel="sitemap" href="/sitemap-index.xml" />

{/* Links for favicons */}
<link href="/favicon.ico" rel="icon" sizes="any" type="image/x-icon" />
<link href={faviconSvg.src} rel="icon" type="image/svg+xml" sizes="any" />
<meta name="mobile-web-app-capable" content="yes" />
<link href={appleTouchIcon.src} rel="apple-touch-icon" />
<link href={appleTouchIcon.src} rel="shortcut icon" />
{/* Set theme color */}
<meta name="theme-color" content="#facc15" />
