---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';

interface ContactCopy {
  title: string;
  subtitle: string;
  formTitle: string;
  formSubtitle: string;
  firstNameLabel: string;
  lastNameLabel: string;
  detailsLabel: string;
  submitLabel: string;
  demoMessage: string;
  knowledgeHeading: string;
  knowledgeContent: string;
  knowledgeLinkLabel: string;
  knowledgeLinkUrl: string;
  faqHeading: string;
  faqContent: string;
  faqLinkLabel: string;
  faqLinkUrl: string;
  officeHeading: string;
  officeName: string;
  officeAddress: string;
  emailHeading: string;
  emailContent: string;
  contactEmail: string;
}

const DEFAULT_COPY: ContactCopy = {
  title: 'Contact Us',
  subtitle:
    "Have questions or want to discuss a project? Reach out, and let's craft the perfect solution with our tools and services.",
  formTitle: 'Fill out the form',
  formSubtitle: "We'll get back to you within 24 hours.",
  firstNameLabel: 'First Name',
  lastNameLabel: 'Last Name',
  detailsLabel: 'Details',
  submitLabel: 'Send Message',
  demoMessage: 'This is a demo form. No data will be sent.',
  knowledgeHeading: 'Knowledge Base',
  knowledgeContent:
    'Looking for answers? Browse our comprehensive documentation and guides.',
  knowledgeLinkLabel: 'Browse Knowledge Base',
  knowledgeLinkUrl: '/blogs/support',
  faqHeading: 'FAQ',
  faqContent: 'Check out our frequently asked questions for quick answers.',
  faqLinkLabel: 'View FAQ',
  faqLinkUrl: '#faq',
  officeHeading: 'Our Office',
  officeName: 'Acme HQ',
  officeAddress: '123 Innovation Drive, Tech City, TC 94105',
  emailHeading: 'Email',
  emailContent:
    "Drop us an email and we'll get back to you as soon as possible.",
  contactEmail: 'info@example.com',
};

interface Props {
  copy?: ContactCopy;
}

const { copy = DEFAULT_COPY } = Astro.props;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subtitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2
          class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300"
        >
          {copy.formTitle}
        </h2>
        <form data-demo-form data-demo-message={copy.demoMessage}>
          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput
                id="hs-firstname-contacts"
                label={copy.firstNameLabel}
                name="hs-firstname-contacts"
              />
              <TextInput
                id="hs-lastname-contacts"
                label={copy.lastNameLabel}
                name="hs-lastname-contacts"
              />
            </div>
            <EmailContactInput id="hs-email-contacts" />
            <PhoneInput id="hs-phone-number" />
            <TextAreaInput
              id="hs-about-contacts"
              label={copy.detailsLabel}
              name="hs-about-contacts"
            />
          </div>

          <div class="mt-4 grid">
            <AuthBtn title={copy.submitLabel} />
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {copy.formSubtitle}
            </p>
            <p
              class="mt-2 hidden text-sm text-orange-500 dark:text-orange-400"
              data-demo-status
              aria-live="polite"
            >
            </p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.knowledgeHeading}
          content={copy.knowledgeContent}
          isLinkVisible={true}
          linkTitle={copy.knowledgeLinkLabel}
          linkURL={copy.knowledgeLinkUrl || '#'}
          isArrowVisible={true}
          ><Icon name="question" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.faqHeading}
          content={copy.faqContent}
          isLinkVisible={true}
          linkTitle={copy.faqLinkLabel}
          linkURL={copy.faqLinkUrl || '#'}
          isArrowVisible={true}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeName}
          isAddressVisible={true}
          addressContent={copy.officeAddress}
          ><Icon name="mapPin" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle={copy.contactEmail}
          linkURL={copy.contactEmail ? 'mailto:' + copy.contactEmail : '#'}
          ><Icon name="envelopeOpen" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
