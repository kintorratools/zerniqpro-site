---
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import type { ProductViewModel } from '@/lib/cms/product-models';

interface Props {
  product: ProductViewModel;
  lang?: 'en' | 'fr';
}

const { product } = Astro.props;

const tabs = [
  {
    title: product.descriptionTabLabel,
    id: 'tabs-with-card-1',
    dataTab: '#tabs-with-card-1',
  },
  {
    title: product.specificationsTabLabel,
    id: 'tabs-with-card-2',
    dataTab: '#tabs-with-card-2',
  },
  {
    title: product.blueprintsTabLabel,
    id: 'tabs-with-card-3',
    dataTab: '#tabs-with-card-3',
  },
];
---

<div
  id="overlay"
  class="pointer-events-none fixed inset-0 bg-neutral-200 dark:bg-neutral-800"
>
</div>

<section
  class="mx-auto flex max-w-[85rem] flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div>
    <p
      id="fadeText"
      class="mb-8 max-w-prose font-light text-pretty text-neutral-700 sm:text-xl dark:text-neutral-300"
    >
      {product.introText}
    </p>
  </div>
  <div
    class="flex flex-col items-center justify-between space-y-4 sm:flex-row sm:space-y-0"
  >
    <div id="fadeInUp">
      <h1
        class="block text-4xl font-bold tracking-tighter text-neutral-800 sm:text-5xl md:text-6xl lg:text-7xl dark:text-neutral-200"
      >
        {product.name}
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400">
        {product.summary}
      </p>
    </div>
    <div class="overflow-hidden">
      <img
        id="fadeInMoveRight"
        src={product.mainImage?.url}
        class="w-[600px] will-change-transform"
        alt={product.mainImageAlt}
        loading="eager"
      />
    </div>
  </div>
</section>

<div
  id="product-detail-body"
  class="mx-auto max-w-[85rem] px-4 pt-10 sm:px-6 lg:px-8 lg:pt-14"
>
  <nav
    class="mx-auto grid max-w-6xl gap-y-px sm:flex sm:gap-x-4 sm:gap-y-0"
    aria-label="Tabs"
    role="tablist"
  >
    {
      tabs.map((tab, index) => (
        <ProductTabBtn
          title={tab.title}
          id={tab.id}
          dataTab={tab.dataTab}
          first={index === 0}
        />
      ))
    }
  </nav>

  <div class="relative mt-12 md:mt-16">
    <div id="tabs-with-card-1" class="product-tab-panel" role="tabpanel">
      <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
        <div class="grid gap-12 md:grid-cols-2">
          <div class="lg:w-3/4">
            <h2
              class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:leading-tight lg:text-4xl dark:text-neutral-200"
            >
              {product.longDescriptionTitle}
            </h2>
            <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
              {product.longDescriptionSubtitle}
            </p>
            <p class="mt-5">
              <PrimaryCTA title={product.ctaLabel} url={product.ctaUrl} />
            </p>
          </div>

          <div class="space-y-6 lg:space-y-10">
            {
              product.descriptionItems.map(list => (
                <div class="flex">
                  <div>
                    <h3 class="text-base font-bold text-neutral-800 sm:text-lg dark:text-neutral-200">
                      {list.title}
                    </h3>
                    <p class="mt-1 text-neutral-600 dark:text-neutral-400">
                      {list.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div id="tabs-with-card-2" class="product-tab-panel hidden" role="tabpanel">
      <div class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8 lg:pb-14">
        <div class="grid w-full grid-cols-1 gap-x-16 md:grid-cols-2">
          <div class="max-w-md space-y-6">
            {
              product.specificationsLeft.map(spec => (
                <div>
                  <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                    {spec.title}
                  </h3>
                  <p class="text-neutral-600 dark:text-neutral-400">
                    {spec.description}
                  </p>
                </div>
              ))
            }
          </div>
          {
            product.specificationsRight &&
            product.specificationsRight.length > 0 ? (
              <div class="mt-6 max-w-md space-y-6 md:mt-0 md:ml-auto">
                {product.specificationsRight?.map(spec => (
                  <div>
                    <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                      {spec.title}
                    </h3>
                    <p class="text-neutral-600 dark:text-neutral-400">
                      {spec.description}
                    </p>
                  </div>
                ))}
              </div>
            ) : product.tableData && product.tableData.length > 0 ? (
              <div class="mt-6 space-y-6 md:mt-0 md:ml-auto">
                <div class="flex flex-col">
                  <div class="-m-1.5 overflow-x-auto">
                    <div class="inline-block min-w-full p-1.5 align-middle">
                      <div class="overflow-hidden">
                        <table class="min-w-full divide-y divide-neutral-300 dark:divide-neutral-700">
                          <thead>
                            <tr>
                              {product.tableData[0]?.feature?.map(header => (
                                <th
                                  scope="col"
                                  class="px-6 py-3 text-start text-xs font-medium text-neutral-500 uppercase dark:text-neutral-500"
                                >
                                  {header}
                                </th>
                              ))}
                            </tr>
                          </thead>
                          <tbody class="divide-y divide-neutral-300 dark:divide-neutral-700">
                            {product.tableData[0]?.description?.map(row => (
                              <tr>
                                {row.map(cell => (
                                  <td class="px-6 py-4 text-sm font-medium whitespace-nowrap text-neutral-600 dark:text-neutral-400">
                                    {cell}
                                  </td>
                                ))}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ) : null
          }
        </div>
      </div>
    </div>

    <div id="tabs-with-card-3" class="product-tab-panel hidden" role="tabpanel">
      <div class="mx-auto mb-20 flex w-full md:mb-28 2xl:w-4/5">
        <div
          class="relative top-12 left-12 z-10 overflow-hidden rounded-xl shadow-lg md:top-16 md:left-12 md:-ml-12 lg:ml-0"
        >
          {
            product.blueprintFirst?.url && (
              <img
                src={product.blueprintFirst.url}
                class="h-full w-full object-cover object-center"
                alt={product.blueprintFirstAlt}
              />
            )
          }
        </div>

        <div class="relative right-12 overflow-hidden rounded-xl shadow-xl">
          {
            product.blueprintSecond?.url && (
              <img
                src={product.blueprintSecond.url}
                class="h-full w-full object-cover object-center"
                alt={product.blueprintSecondAlt}
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  if (prefersReducedMotion) {
    gsap.set(
      ['#fadeText', '#fadeInUp', '#fadeInMoveRight', '#product-detail-body'],
      { clearProps: 'all' }
    );
    gsap.set('#overlay', { autoAlpha: 0, display: 'none' });
  } else {
    gsap.set('#fadeText', { autoAlpha: 0, y: 20 });
    gsap.set('#fadeInUp', { autoAlpha: 0, y: 28 });
    gsap.set('#fadeInMoveRight', { autoAlpha: 0, x: 56, scale: 0.97 });
    gsap.set('#product-detail-body', { autoAlpha: 0, y: 24 });

    const revealContent = () => {
      gsap.set(
        ['#fadeText', '#fadeInUp', '#fadeInMoveRight', '#product-detail-body'],
        { autoAlpha: 1, x: 0, y: 0, scale: 1 }
      );
      gsap.set('#overlay', { autoAlpha: 0, display: 'none' });
    };

    const safetyId = window.setTimeout(revealContent, 2200);

    gsap
      .timeline({
        defaults: { ease: 'power3.out' },
        onComplete: () => {
          window.clearTimeout(safetyId);
          gsap.set('#overlay', { display: 'none' });
        },
      })
      .to(
        '#overlay',
        {
          autoAlpha: 0,
          duration: 0.65,
          ease: 'power2.inOut',
        },
        0.08
      )
      .to(
        '#fadeText',
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.85,
        },
        0.12
      )
      .to(
        '#fadeInUp',
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.95,
        },
        0.22
      )
      .to(
        '#fadeInMoveRight',
        {
          autoAlpha: 1,
          x: 0,
          scale: 1,
          duration: 1.05,
        },
        0.18
      )
      .to(
        '#product-detail-body',
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.8,
        },
        0.42
      );
  }

  function changeHeadingStyle(
    button: Element,
    addClasses: string[],
    removeClasses: string[]
  ) {
    const heading = button.querySelector('span');
    if (heading) {
      heading.classList.remove(...removeClasses);
      heading.classList.add(...addClasses);
    }
  }

  function setButtonInactive(btn: Element, activeButton: Element) {
    if (btn === activeButton) return;

    btn.classList.remove(
      'active',
      'bg-neutral-100',
      'hover:border-transparent',
      'dark:bg-white/[.05]'
    );

    changeHeadingStyle(
      btn,
      ['text-neutral-800', 'dark:text-neutral-200'],
      ['text-orange-400', 'dark:text-orange-300']
    );
  }

  function setButtonActive(button: Element) {
    button.classList.add(
      'active',
      'bg-neutral-100',
      'hover:border-transparent',
      'dark:bg-white/[.05]'
    );

    changeHeadingStyle(
      button,
      ['text-orange-400', 'dark:text-orange-300'],
      ['text-neutral-800', 'dark:text-neutral-200']
    );
  }

  const tabButtons = Array.from(document.querySelectorAll('[data-target]'));
  const tabPanels = Array.from(document.querySelectorAll('.product-tab-panel'));

  function selectTab(index: number) {
    if (index < 0 || index >= tabButtons.length) return;

    tabButtons.forEach((btn, i) => {
      if (i === index) {
        setButtonActive(btn);
      } else {
        setButtonInactive(btn, tabButtons[index]);
      }
    });

    tabPanels.forEach((panel, i) => {
      if (i === index) {
        panel.classList.remove('hidden');
      } else {
        panel.classList.add('hidden');
      }
    });
  }

  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      selectTab(index);
    });
  });
</script>
