---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import EmailFooterInput from '@components/ui/forms/input/EmailFooterInput.astro';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import { getMarketingLocale } from '@utils/locale';
import type { FooterViewModel } from '@lib/cms/footer-models';
import type { BrandViewModel } from '@lib/cms/brand-models';

interface Props {
  footer?: FooterViewModel;
  brand?: BrandViewModel;
}

const { footer, brand } = Astro.props;

const locale = getMarketingLocale(Astro.url.pathname, Astro.currentLocale);

const FALLBACK_FOOTER: FooterViewModel = {
  columns: [],
  copyright: '',
  legalLinks: [],
  socialLinks: [],
};
const footerData =
  footer && (footer.columns.length > 0 || footer.copyright)
    ? footer
    : FALLBACK_FOOTER;

const sectionThreeTitle: string =
  locale === 'fr' ? 'Rester à jour' : 'Stay up to date';
const sectionThreeContent: string =
  locale === 'fr'
    ? 'Restez informé des derniers outils et des offres exclusives.'
    : 'Stay updated with the latest tools and exclusive deals.';
const newsletterDemoMessage =
  locale === 'fr'
    ? 'Merci ! (démo — branchez un service e-mail pour collecter de vrais abonnés.)'
    : 'Thanks! (Demo only — wire an email service to collect real subscribers.)';
---

<footer class="w-full bg-neutral-300 dark:bg-neutral-900">
  <div
    class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-20 2xl:max-w-(--breakpoint-2xl)"
  >
    <div class="grid grid-cols-2 gap-6 md:grid-cols-4 lg:grid-cols-5">
      <div class="col-span-full lg:col-span-1">
        {/* Brand Logo */}
        <BrandLogo class="h-auto w-32" />
      </div>
      {/* Footer columns from CMS */}
      {
        footerData.columns.length > 0
          ? footerData.columns.map(column => (
              <div class="col-span-1">
                <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
                  {column.title}
                </h3>
                <ul class="mt-3 grid space-y-3">
                  {column.links.map((link, index) => (
                    <li>
                      <a
                        href={link.url}
                        class="inline-flex gap-x-2 rounded-lg text-neutral-600 ring-zinc-500 outline-hidden transition duration-300 hover:text-neutral-500 focus-visible:ring-3 dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-300 dark:focus:outline-hidden"
                      >
                        {link.label}
                      </a>
                      {column.title === 'Company' && index === 2 ? (
                        <span class="ms-1 inline rounded-lg bg-orange-500 px-2 py-1 text-xs font-bold text-neutral-50">
                          We're hiring!
                        </span>
                      ) : null}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          : null
      }

      <div class="col-span-2">
        <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
          {sectionThreeTitle}
        </h3>

        <form data-demo-form data-demo-message={newsletterDemoMessage}>
          <EmailFooterInput />
          <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">
            {sectionThreeContent}
          </p>
        </form>
      </div>
    </div>

    <div
      class="mt-9 grid gap-y-2 sm:mt-12 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
    >
      <div class="flex items-center justify-between">
        <p class="text-sm text-neutral-600 dark:text-neutral-400">
          © <span id="current-year"></span>{
            footerData.copyright ? ` ${footerData.copyright}.` : ''
          }
        </p>
      </div>

      {/* Social Brands */}
      <div>
        {
          footerData.socialLinks.map(link => {
            const iconName = link.platform.toLowerCase() + 'Footer';
            return (
              <FooterSocialLink url={link.url} label={link.platform}>
                <Icon name={iconName} />
              </FooterSocialLink>
            );
          })
        }
      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById('current-year');
      element!.innerText = year.toString();
    </script>
  </div>
</footer>
