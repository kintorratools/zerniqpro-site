---
// Importing necessary components
import Meta from '@components/Meta.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '@components/sections/navbar&footer/FooterSection.astro';
import { getRuntimeConfig } from '@lib/runtime/site-runtime';
import '@styles/global.css';

// Setting expected props
const {
  title = '',
  meta,
  structuredData,
  lang = 'en',
  customDescription = null,
  customOgTitle = null,
  hideFooter = false,
} = Astro.props;

// During build-time prerendering (SSG), STRAPI_URL may not be set.
// Fall back to empty defaults so static pages still render.
let runtime;
try {
  runtime = await getRuntimeConfig();
} catch {
  runtime = {
    site: {
      key: 'site-template',
      name: '',
      defaultLocale: 'en',
      seo: { title: '', description: '' },
      brandKey: '',
    },
    brand: {
      key: 'site-template',
      name: '',
      domain: 'https://example.com',
      seo: { title: '', description: '' },
    },
    locales: [],
    navigation: { items: [] },
    footer: { columns: [], copyright: '', legalLinks: [], socialLinks: [] },
  };
}

// Interface to type-check the properties
interface Props {
  title?: string;
  meta?: string;
  structuredData?: Record<string, unknown>;
  lang?: string;
  customDescription?: string | null;
  customOgTitle?: string | null;
  hideFooter?: boolean;
}
---

<html lang={lang} class="scrollbar-hide lenis lenis-smooth scroll-pt-16">
  <head>
    {/* Adding metadata to the HTML document */}
    <Meta
      meta={meta}
      structuredData={structuredData}
      customDescription={customDescription}
      customOgTitle={customOgTitle}
      brand={runtime.brand}
      site={runtime.site}
      locales={runtime.locales}
    />
    {/* Define the title of the page */}
    <title>{title || runtime.brand.name}</title>
    <script is:inline>
      // Script to handle dark mode. It will check if the theme is stored in localStorage or if dark theme is preferred by system settings
      if (
        localStorage.getItem('hs_theme') === 'dark' ||
        (!('hs_theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <script>
      import '@scripts/lenisSmoothScroll.js';
      import '@scripts/demoForms.js';
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-neutral-200 selection:bg-yellow-400 selection:text-neutral-700 dark:bg-neutral-800"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-yellow-400 focus:px-4 focus:py-2 focus:text-neutral-800"
    >
      Skip to content
    </a>
    {
      /*
    Setting up the main structure of the page.
    The Navbar is placed at the top, with a slot for the main content and FooterSection at the bottom.
    */
    }
    <div
      class="mx-auto w-full max-w-(--breakpoint-2xl) grow px-4 sm:px-6 lg:px-8"
    >
      <Navbar
        items={runtime.navigation.items}
        locales={runtime.locales}
        brand={runtime.brand}
      />
      <main id="main-content">
        <slot />
      </main>
    </div>
    {
      !hideFooter && (
        <FooterSection footer={runtime.footer} brand={runtime.brand} />
      )
    }
    <script>
      // https://preline.co
      import 'preline';
      const init = () =>
        (
          window as Window & { HSStaticMethods?: { autoInit?: () => void } }
        ).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
    <style>
      /* CSS rules for the page scrollbar */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }

      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
