---
import { SITE } from '@data/constants';
import MainLayout from '@/layouts/MainLayout.astro';
import InsightDetail from '@components/sections/insights/InsightDetail.astro';
import { getCollection } from 'astro:content';
import { getRuntimeConfig } from '@/lib/runtime/site-runtime';

export async function getStaticPaths() {
  const insightPosts = await getCollection('insights', ({ id }) =>
    id.startsWith('fr/')
  );
  return insightPosts.map(post => {
    const idWithoutLang = post.id.replace(/^fr\//, '');
    return {
      params: { lang: 'fr', id: idWithoutLang },
      props: { post },
    };
  });
}

const { post } = Astro.props;

// Get site domain from runtime config
let siteUrl = SITE.url;
try {
  const runtime = await getRuntimeConfig('fr');
  siteUrl = runtime.site?.domain
    ? runtime.site.domain.replace(/\/+$/, '')
    : SITE.url;
} catch {
  /* fallback */
}

const pageTitle: string = `${post.data.title} | ${SITE.title}`;
const metaDescription = post.data.description;
const ogTitle = `${post.data.title} | Insights | ${SITE.title}`;
const insightId = post.id.replace(/^fr\//, '');
---

<MainLayout
  title={pageTitle}
  lang="fr"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: metaDescription,
    image: post.data.cardImage.src,
    author: {
      '@type': 'Organization',
      name: SITE.title,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.title,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/favicon.ico`,
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${siteUrl}/fr/insights/${insightId}`,
    },
    inLanguage: 'fr',
  }}
>
  <InsightDetail post={post} lang="fr" />
</MainLayout>
