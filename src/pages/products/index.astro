---
// Importing necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import CardSmall from '@components/ui/cards/CardSmall.astro';
import CardWide from '@components/ui/cards/CardWide.astro';
import FeaturesStatsAlt from '@components/sections/features/FeaturesStatsAlt.astro';
import TestimonialsSectionAlt from '@components/sections/testimonials/TestimonialsSectionAlt.astro';

// Importing CMS data functions
import { getAllProducts, getProductPage } from '@/lib/cms/product';
import { getRuntimeConfig } from '@/lib/runtime/site-runtime';
import { SITE } from '@data/constants';

// Fetch CMS data
const products = await getAllProducts('en');
const productPage = await getProductPage('en');

// Fetch runtime config for SEO URLs
let siteDomain = SITE.url;
try {
  const runtimeConfig = await getRuntimeConfig();
  if (runtimeConfig?.site?.domain) {
    siteDomain = runtimeConfig.site.domain.replace(/\/+$/, '');
  }
} catch {
  // fall back to SITE.url
}

// Page content from CMS
const title: string = productPage.title;
const subTitle: string = productPage.subtitle;
const customerStoriesLabel: string = productPage.customerStoriesLabel;
const whyChooseTitle: string = productPage.whyChooseTitle;
const whyChooseSubtitle: string = productPage.whyChooseSubtitle;

// Testimonials from CMS
const testimonials = productPage.testimonials.map(t => ({
  content: t.content,
  author: t.author,
  role: t.role,
  avatarSrc: t.avatar?.url || '',
  avatarAlt: t.avatar?.alternativeText || '',
}));

// Benefits from CMS
const benefits = [
  productPage.benefit1,
  productPage.benefit2,
  productPage.benefit3,
];

// SEO from CMS
const pageTitle: string = productPage.seo?.title
  ? `${productPage.seo.title} | ${SITE.title}`
  : `${title} | ${SITE.title}`;
const metaDescription = productPage.seo?.description || productPage.subtitle;
const ogTitle = productPage.seo?.title || title;

// Canonical URL
const canonicalUrl = `${siteDomain}/products`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': canonicalUrl,
    url: canonicalUrl,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: siteDomain,
      name: SITE.title,
      description: SITE.description,
    },
    inLanguage: 'en-US',
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex items-center gap-12">
        <h1
          class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
        >
          {title}
        </h1>
        {
          subTitle && (
            <p class="hidden max-w-(--breakpoint-sm) text-pretty text-neutral-600 md:block dark:text-neutral-400">
              {subTitle}
            </p>
          )
        }
      </div>
      <PrimaryCTA
        title={customerStoriesLabel}
        url="#testimonials"
        noArrow={true}
      />
    </div>
    {
      /* Displaying products in alternating styles. Alternative product gets different card styling. */
    }
    {
      /* Maps through all product entries and displays them with either CardSmall or CardWide based on their position. */
    }
    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
      {
        products.map((product, index) => {
          const position = index % 4;
          if (position === 0 || position === 3) {
            return <CardSmall product={product} />;
          } else {
            return <CardWide product={product} />;
          }
        })
      }
    </section>
  </div>
  {/* Features statistics section */}
  <FeaturesStatsAlt
    title={whyChooseTitle}
    subTitle={whyChooseSubtitle}
    benefits={benefits}
  />
  {/* Testimonials section */}
  <TestimonialsSectionAlt
    title={productPage.testimonialsTitle}
    testimonials={testimonials}
  />
</MainLayout>
