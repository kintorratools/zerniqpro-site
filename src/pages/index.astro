---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/hero-image.avif';
import featureImage from '@images/features-image.avif';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { partnersData } from '@/data_files/constants';
import { getHomepage } from '@lib/cms/homepage';
import { HOMEPAGE_BASELINE } from '@lib/homepage/homepage-baseline';
import { resolveHomepageContent } from '@lib/homepage/homepage-resolver';
import { escapeCmsText } from '@lib/homepage/html-escape';
import { getRuntimeConfig } from '@lib/runtime/site-runtime';
import { resolveGlobalSeo } from '@lib/cms/seo';

export const prerender = false;

// ── Fetch CMS Homepage + merge with baseline ──

let runtime;
try {
  runtime = await getRuntimeConfig();
} catch {
  runtime = null;
}

const siteKey = runtime?.site?.key ?? 'store-us';
const locale = runtime?.site?.defaultLocale ?? 'en';

let cmsHomepage = null;
let cmsWarning = null;
try {
  cmsHomepage = await getHomepage(siteKey, locale);
} catch (e) {
  cmsWarning = `[Homepage] CMS fetch failed, using baseline: ${e instanceof Error ? e.message : 'unknown error'}`;
  console.warn(cmsWarning);
}

const merged = resolveHomepageContent(cmsHomepage, HOMEPAGE_BASELINE);

// If CMS returned null (not found / not configured), log warning
if (!cmsHomepage && !cmsWarning) {
  console.warn('[Homepage] No published CMS homepage found, using baseline');
}

// ── SEO resolution ──
const pageSeo = {
  title: merged.seo.title || undefined,
  description: merged.seo.description || undefined,
};
const globalSeo = runtime
  ? resolveGlobalSeo(pageSeo, runtime)
  : {
      title: merged.seo.title || '',
      description: merged.seo.description || '',
    };

// ── Build component props from merged data ──

// Hero: build title with highlight span
const heroTitle = `${escapeCmsText(merged.hero.titleBefore)}<span class="text-yellow-500 dark:text-yellow-400">${escapeCmsText(merged.hero.highlightText)}</span>${escapeCmsText(merged.hero.titleAfter)}`;

// FeaturesNavs: build title with highlight span
const featuresNavsTitle = `${escapeCmsText(merged.featuresNavs.titleBefore)}<span class="text-yellow-500 dark:text-yellow-400">${escapeCmsText(merged.featuresNavs.highlightText)}</span>${escapeCmsText(merged.featuresNavs.titleAfter)}`;

// FeaturesNavs: map CMS tabs to component shape, fallback to local images
const localTabImages = [tools, dashboard, construction];
const tabs = merged.featuresNavs.tabs.map((tab, i) => ({
  heading: tab.heading,
  content: tab.content,
  svg: tab.iconKey,
  src: tab.image?.url || (localTabImages[i] ?? construction),
  alt: tab.image?.alt || tab.imageAlt || '',
  ...(i === 0 ? { first: true } : {}),
  ...(i === 1 ? { second: true } : {}),
}));

// Testimonials: map CMS data to component shape
const testimonials = merged.testimonials.items.map(t => ({
  content: t.content,
  author: t.author,
  role: t.role,
  avatarSrc: t.avatar?.url ?? '',
}));

// Clients: merge CMS partner names/urls with partnersData SVG icons
const partners = partnersData.map((p, i) => {
  const cmsPartner = merged.clients.partners[i];
  return {
    icon: p.icon,
    name: cmsPartner?.name || p.name,
    href: cmsPartner?.url || p.href,
  };
});

// FAQ: build title with <br /> separator
const faqTitle = `${escapeCmsText(merged.faq.titleLine1)}<br />${escapeCmsText(merged.faq.titleLine2)}`;

// Pricing: map to PricingSection expected shape
const pricingData = {
  title: merged.pricing.title,
  subTitle: merged.pricing.subTitle,
  badge: merged.pricing.badge,
  thirdOption: merged.pricing.thirdOption,
  btnText: merged.pricing.btnText,
  starterKit: merged.pricing.starterKit,
  professionalToolbox: merged.pricing.professionalToolbox,
};

const avatarSrcs: Array<any> =
  merged.hero.avatars.length > 0 && merged.hero.avatars.some(a => a?.url)
    ? merged.hero.avatars.map(a => a?.url || '')
    : [
        'https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
        'https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
        'https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80',
        'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
      ];
---

<MainLayout
  title={globalSeo.title}
  customDescription={globalSeo.description}
  customOgTitle={globalSeo.title}
>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle={merged.announcement.buttonLabel}
    url={merged.announcement.url}
  />

  <HeroSection
    title={heroTitle}
    subTitle={merged.hero.subTitle}
    primaryBtn={merged.hero.primaryButtonLabel}
    primaryBtnURL={merged.hero.primaryButtonUrl}
    secondaryBtn={merged.hero.secondaryButtonLabel}
    secondaryBtnURL={merged.hero.secondaryButtonUrl}
    withReview={merged.hero.withReview}
    avatars={avatarSrcs}
    rating={`<span class="font-bold">${escapeCmsText(merged.hero.ratingText)}</span>`}
    starCount={merged.hero.starCount}
    reviews={`<span class="font-bold">${escapeCmsText(merged.hero.reviewsText)}</span>`}
    src={merged.hero.image?.url ? merged.hero.image.url : heroImage}
    alt={merged.hero.image?.alt || merged.hero.imageAlt}
  />

  <ClientsSection
    title={merged.clients.title}
    subTitle={merged.clients.subTitle}
    partners={partners}
  />

  <FeaturesGeneral
    title={merged.featuresGeneral.title}
    subTitle={merged.featuresGeneral.subTitle}
    src={merged.featuresGeneral.image?.url
      ? merged.featuresGeneral.image.url
      : featureImage}
    alt={merged.featuresGeneral.image?.alt || merged.featuresGeneral.imageAlt}
    features={merged.featuresGeneral.items}
  />

  <FeaturesNavs title={featuresNavsTitle} tabs={tabs} />

  <TestimonialsSection
    title={merged.testimonials.title}
    subTitle={merged.testimonials.subTitle}
    testimonials={testimonials}
    statistics={merged.testimonials.statistics}
  />

  <PricingSection pricing={pricingData} />

  <FAQ title={faqTitle} faqs={{ faqs: merged.faq.items }} />

  <HeroSectionAlt
    title={merged.bottomCta.title}
    subTitle={merged.bottomCta.subTitle}
    url={merged.bottomCta.url}
  />
</MainLayout>
