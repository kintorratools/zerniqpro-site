---
// Import necessary components and utilities
import MainLayout from '@/layouts/MainLayout.astro';
import AvatarBlogLarge from '@components/ui/avatars/AvatarBlogLarge.astro';
import CardRelated from '@components/ui/cards/CardRelated.astro';
import Bookmark from '@components/ui/buttons/Bookmark.astro';
import SocialShare from '@components/ui/buttons/SocialShare.astro';
import PostFeedback from '@components/ui/feedback/PostFeedback.astro';
import UnifiedImage from '@components/ui/media/UnifiedImage.astro';
import { Image } from 'astro:assets';
import { capitalize, formatDate } from '@utils/utils';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '@data/constants';
import { getRuntimeConfig } from '@/lib/runtime/site-runtime';
import { getCmsArticleBySlug, renderBlocksToHtml } from '@/lib/cms/blog-data';
import type { SupportArticleViewModel } from '@/lib/cms/support-models';

// Update getStaticPaths for English posts
export async function getStaticPaths() {
  const blogPosts = await getCollection('blog', ({ id }) =>
    id.startsWith('en/')
  );
  // Also include CMS blog articles as paths
  const { getCmsBlogArticles } = await import('@/lib/cms/blog-data');
  let cmsSlugs: string[] = [];
  try {
    const cmsArticles = await getCmsBlogArticles('en');
    cmsSlugs = cmsArticles.map(a => a.slug);
  } catch {
    /* ignore */
  }

  const mdxPaths = blogPosts.map(post => {
    const idWithoutLang = post.id.replace(/^en\//, '');
    return { params: { id: idWithoutLang }, props: { post, cmsData: null } };
  });

  // Add CMS-only paths
  const seen = new Set(blogPosts.map(p => p.id.replace(/^en\//, '')));
  const cmsPaths = cmsSlugs
    .filter(s => !seen.has(s))
    .map(slug => ({
      params: { id: slug },
      props: { post: null, cmsSlug: slug },
    }));

  return [...mdxPaths, ...cmsPaths];
}

// Get the current post's data
const { post, cmsSlug } = Astro.props;

// Try to fetch from CMS first
let cmsArticle: SupportArticleViewModel | null = null;
if (cmsSlug) {
  cmsArticle = await getCmsArticleBySlug(cmsSlug, 'en');
} else if (post) {
  const slug = post.id.replace(/^en\//, '');
  cmsArticle = await getCmsArticleBySlug(slug, 'en');
}

// Get site domain from runtime config
let siteUrl = SITE.url;
try {
  const runtime = await getRuntimeConfig('en');
  siteUrl = runtime.site?.domain
    ? runtime.site.domain.replace(/\/+$/, '')
    : SITE.url;
} catch {
  /* fallback */
}

const blogPosts: CollectionEntry<'blog'>[] = await getCollection(
  'blog',
  ({ id }) => id.startsWith('en/')
);

// Filter out the current post to get related posts
const currentSlug =
  cmsArticle?.slug || (post ? post.id.replace(/^en\//, '') : '');
const relatedPosts: CollectionEntry<'blog'>[] = blogPosts.filter(
  blogEntry => blogEntry.id !== post?.id
);

// Page metadata from CMS or MDX
const pageTitle: string = cmsArticle
  ? `${cmsArticle.title} | ${SITE.title}`
  : `${post!.data.title} | ${SITE.title}`;
const metaDescription = cmsArticle?.excerpt || post?.data.description || '';
const ogTitle = cmsArticle
  ? `${cmsArticle.title} | Blog | ${SITE.title}`
  : `${post!.data.title} | Blog | ${SITE.title}`;

const displayTitle = cmsArticle?.title || post?.data.title || '';
const displayAuthor = cmsArticle?.author || post?.data.author || '';
const displayDate = cmsArticle?.displayDate
  ? new Date(cmsArticle.displayDate)
  : post?.data.pubDate || new Date();
const displayReadTime = cmsArticle?.readTimeMinutes || post?.data.readTime || 0;
const displayTags = cmsArticle?.tags || post?.data.tags || [];
const displayImageUrl = cmsArticle?.cardImage?.url || '';
const displayImageAlt =
  cmsArticle?.cardImageAlt || post?.data.cardImageAlt || '';
const cmsHtmlContent = cmsArticle
  ? renderBlocksToHtml(cmsArticle.content)
  : null;
const isCmsDriven = Boolean(cmsArticle);
const { Content } = post ? await render(post) : { Content: null };
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: displayTitle,
    image: isCmsDriven ? displayImageUrl : post?.data.cardImage.src,
    datePublished: displayDate.toISOString(),
    author: {
      '@type': 'Person',
      name: displayAuthor,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.title,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/favicon.ico`,
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${siteUrl}/blog/${currentSlug}`,
    },
  }}
>
  <section class="mx-auto max-w-3xl px-4 pt-6 pb-12 sm:px-6 lg:px-8 lg:pt-10">
    <div class="max-w-2xl">
      <div class="mb-6 flex items-center justify-between">
        <div class="flex w-full gap-x-5 sm:items-center sm:gap-x-3">
          {
            isCmsDriven ? (
              <div class="flex items-center gap-x-3">
                {cmsArticle?.authorImage?.url && (
                  <UnifiedImage
                    class="size-16 shrink-0 rounded-full object-cover"
                    src={cmsArticle.authorImage.url}
                    alt={displayAuthor}
                  />
                )}
                <div>
                  <span class="font-bold text-neutral-700 dark:text-neutral-300">
                    {displayAuthor}
                  </span>
                  <ul class="text-xs text-neutral-500">
                    <li class="relative inline-block pe-6 before:absolute before:end-2 before:top-1/2 before:size-1 before:-translate-y-1/2 before:rounded-full before:bg-neutral-300 last:pe-0 last-of-type:before:hidden dark:text-neutral-400 dark:before:bg-neutral-600">
                      {formatDate(displayDate)}
                    </li>
                    <li class="relative inline-block pe-6 before:absolute before:end-2 before:top-1/2 before:size-1 before:-translate-y-1/2 before:rounded-full before:bg-neutral-300 last:pe-0 last-of-type:before:hidden dark:text-neutral-400 dark:before:bg-neutral-600">
                      {displayReadTime} min read
                    </li>
                  </ul>
                </div>
              </div>
            ) : (
              post && <AvatarBlogLarge blogEntry={post} />
            )
          }
        </div>
      </div>
      <!-- Blog post title -->
      <h2
        class="mb-3 text-2xl font-bold text-neutral-800 md:text-3xl dark:text-neutral-200"
      >
        {displayTitle}
      </h2>
      {
        isCmsDriven ? (
          displayImageUrl && (
            <UnifiedImage
              class="mb-5 w-full rounded-xl object-cover md:mb-8"
              src={displayImageUrl}
              alt={displayImageAlt}
              breakpoints="content"
            />
          )
        ) : post ? (
          <Image
            class="mb-5 w-full rounded-xl object-cover md:mb-8"
            src={post.data.cardImage}
            alt={post.data.cardImageAlt}
            draggable={'false'}
            format={'avif'}
          />
        ) : null
      }
      <!-- Blog post contents -->
      <article
        class="prose prose-lg prose-neutral dark:prose-invert mb-5 max-w-none text-pretty md:mb-8"
      >
        {
          isCmsDriven ? (
            <Fragment set:html={cmsHtmlContent} />
          ) : Content ? (
            <Content />
          ) : null
        }
      </article>
      <div
        class="mx-auto grid max-w-(--breakpoint-lg) gap-y-5 sm:flex sm:items-center sm:justify-between sm:gap-y-0"
      >
        {/* Blog post tags */}
        <div
          class="flex flex-wrap gap-x-2 gap-y-1 sm:flex-nowrap sm:items-center sm:gap-y-0"
        >
          {
            displayTags.map((tag: string) => (
              <span class="inline-flex items-center gap-x-1.5 rounded-lg bg-neutral-400/30 px-3 py-1.5 text-xs font-medium text-neutral-700 outline-hidden focus:outline-hidden focus-visible:ring-3 focus-visible:outline-hidden dark:bg-neutral-700/60 dark:text-neutral-300">
                {capitalize(tag)}
              </span>
            ))
          }
        </div>
        {/* Bookmark and Share buttons */}
        <div class="flex items-center justify-end gap-x-1.5">
          <Bookmark />
          <div
            class="mx-3 block h-4 border-e border-neutral-400 dark:border-neutral-500"
          >
          </div>
          <div class="inline-flex">
            <SocialShare pageTitle={displayTitle} />
          </div>
        </div>
      </div>
    </div>
    <PostFeedback
      title="Was this post helpful?"
      firstChoice="Yes"
      secondChoice="No"
    />
  </section>

  <!-- Related articles section -->
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mb-10 max-w-2xl">
      <h2
        class="text-2xl font-bold text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        Related articles
      </h2>
    </div>

    <div class="grid grid-cols-2 gap-6">
      {relatedPosts.map(entry => <CardRelated blogEntry={entry} />)}
    </div>
  </section>
</MainLayout>
