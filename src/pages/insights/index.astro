---
// Import necessary components, modules and types
import MainLayout from '@/layouts/MainLayout.astro';
import CardInsight from '@components/ui/cards/CardInsight.astro';
import UnifiedImage from '@components/ui/media/UnifiedImage.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '@data/constants';
import { getRuntimeConfig } from '@/lib/runtime/site-runtime';
import { getCmsInsightArticles } from '@/lib/cms/blog-data';

// Get brand and site domain from runtime config
let brandName = SITE.title;
let siteUrl = SITE.url;
try {
  const runtime = await getRuntimeConfig('en');
  brandName = runtime.brand?.name || runtime.site?.name || SITE.title;
  siteUrl = runtime.site?.domain
    ? runtime.site.domain.replace(/\/+$/, '')
    : SITE.url;
} catch {
  /* fallback to SITE constants */
}

// Fetch CMS data first (PRIMARY source)
const cmsInsightArticles = await getCmsInsightArticles('en');
const hasCmsInsight = cmsInsightArticles.length > 0;

// Get all insight posts in English (MDX fallback)
const englishInsightsEntries = await getCollection('insights', ({ id }) => {
  return id.startsWith('en/');
});

const insightPosts: CollectionEntry<'insights'>[] = englishInsightsEntries;

// Define variables for page content
const title: string = 'Insights';
const subTitle: string = `Stay up-to-date with the latest trends and developments in the construction industry with insights from ${brandName}'s team of industry experts.`;

const pageTitle: string = `Insights | ${brandName}`;
const metaDescription = `Explore industry insights, trends, and expert analysis from ${brandName}. Stay informed about the latest developments in construction and hardware.`;
const ogTitle = `Industry Insights | ${brandName}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${siteUrl}/insights`,
    url: `${siteUrl}/insights`,
    name: `Insights | ${brandName}`,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: siteUrl,
      name: brandName,
      description: SITE.description,
    },
    inLanguage: 'en-US',
  }}
>
  <section
    class="mx-auto max-w-[85rem] space-y-8 px-4 pt-16 sm:px-6 lg:px-8 2xl:max-w-full"
  >
    {/* Page header */}
    <div class="mx-auto max-w-3xl text-left sm:text-center">
      <h1
        class="block text-4xl font-bold tracking-tight text-balance text-neutral-800 md:text-5xl lg:text-6xl dark:text-neutral-200"
      >
        {title}
      </h1>

      <p
        class="mt-4 text-lg text-pretty text-neutral-600 dark:text-neutral-400"
      >
        {subTitle}
      </p>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    {
      hasCmsInsight ? (
        cmsInsightArticles.length === 0 ? (
          <p class="text-center text-neutral-600 dark:text-neutral-400">
            No insights yet. Check back soon.
          </p>
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {cmsInsightArticles.map(article => (
              <a
                class="group rounded-xl ring-zinc-500 outline-hidden transition duration-300 focus-visible:ring-3 dark:ring-zinc-200 dark:focus:outline-hidden"
                href={`/insights/${article.slug}/`}
              >
                <div class="relative overflow-hidden rounded-xl pt-[50%] sm:pt-[70%]">
                  {article.cardImage?.url && (
                    <UnifiedImage
                      class="absolute start-0 top-0 size-full rounded-xl object-cover transition duration-500 ease-in-out group-hover:scale-105"
                      src={article.cardImage.url}
                      alt={article.cardImageAlt}
                      loading="lazy"
                      breakpoints="content"
                    />
                  )}
                </div>
                <div class="mt-7">
                  <h3 class="text-xl font-bold text-neutral-800 group-hover:text-neutral-600 dark:text-neutral-200 dark:group-hover:text-neutral-400">
                    {article.title}
                  </h3>
                  <p class="mt-3 text-neutral-600 dark:text-neutral-400">
                    {article.excerpt}
                  </p>
                  <p class="mt-5 inline-flex items-center gap-x-1 font-medium text-orange-400 decoration-2 group-hover:underline dark:text-orange-300">
                    Read more
                  </p>
                </div>
              </a>
            ))}
          </div>
        )
      ) : insightPosts.length === 0 ? (
        <p class="text-center text-neutral-600 dark:text-neutral-400">
          No insights yet. Check back soon.
        </p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {insightPosts.map(insightEntry => (
            <CardInsight insightEntry={insightEntry} />
          ))}
        </div>
      )
    }
  </section>
</MainLayout>
