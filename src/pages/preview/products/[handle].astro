---
export const prerender = false;

import { getCmsConfig } from '@lib/cms/config';
import { getRuntimeConfig } from '@lib/runtime/site-runtime';
import { getProductByHandle } from '@lib/cms/product';
import {
  CmsTimeoutError,
  CmsNotConfiguredError,
  CmsContentNotFoundError,
} from '@lib/cms/errors';

const handle = Astro.params.handle!;

function errorResponse(status: number, html: string): Response {
  return new Response(html, {
    status,
    headers: { 'X-Robots-Tag': 'noindex, nofollow' },
  });
}

const config = getCmsConfig();

if (!config.configured) {
  return errorResponse(
    503,
    '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>503 — CMS Not Configured</title></head><body><h1>503 — CMS Not Configured</h1></body></html>'
  );
}

let runtime;
let product;

try {
  runtime = await getRuntimeConfig();
} catch (e) {
  if (e instanceof CmsTimeoutError) {
    return errorResponse(
      504,
      '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>504 — Gateway Timeout</title></head><body><h1>504 — Gateway Timeout</h1></body></html>'
    );
  }
  if (e instanceof CmsNotConfiguredError) {
    return errorResponse(
      503,
      '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>503 — CMS Not Configured</title></head><body><h1>503 — CMS Not Configured</h1></body></html>'
    );
  }
  return errorResponse(
    502,
    '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>502 — Bad Gateway</title></head><body><h1>502 — Bad Gateway</h1></body></html>'
  );
}

try {
  product = await getProductByHandle(handle, runtime.site.defaultLocale);
} catch (e) {
  if (e instanceof CmsTimeoutError) {
    return errorResponse(
      504,
      '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>504 — Gateway Timeout</title></head><body><h1>504 — Gateway Timeout</h1></body></html>'
    );
  }
  if (e instanceof CmsContentNotFoundError) {
    return errorResponse(
      404,
      '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>404 — Not Found</title></head><body><h1>404 — Not Found</h1></body></html>'
    );
  }
  return errorResponse(
    502,
    '<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>502 — Bad Gateway</title></head><body><h1>502 — Bad Gateway</h1></body></html>'
  );
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const canonical = `${runtime.site.domain}/products/${handle}/`;
const pageTitle = `${product.seo.title} | ${runtime.site.name}`;

const jsonLdString = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: product.summary,
  brand: {
    '@type': 'Brand',
    name: runtime.brand.name,
  },
});
---

<!doctype html>
<html lang={runtime.site.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <title>{pageTitle}</title>
    <meta name="description" content={product.seo.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Fragment
      set:html={`<script type="application/ld+json">${jsonLdString}</script>`}
    />
  </head>
  <body>
    <main>
      <h1>{product.name}</h1>

      {product.summary && <p>{product.summary}</p>}

      {product.introText && (
        <section>
          <p>{product.introText}</p>
          {product.mainImage?.url && (
            <img
              src={product.mainImage.url}
              alt={product.mainImageAlt || ''}
              style="max-width:100%;height:auto;aspect-ratio:16/9"
            />
          )}
        </section>
      )}

      {
        product.descriptionItems.length > 0 && (
          <section>
            <h2>{product.descriptionTabLabel}</h2>
            {product.longDescriptionTitle && (
              <h3>{product.longDescriptionTitle}</h3>
            )}
            {product.longDescriptionSubtitle && (
              <p>{product.longDescriptionSubtitle}</p>
            )}
            <dl>
              {product.descriptionItems.map((item) => (
                <div>
                  <dt>{item.title}</dt>
                  <dd>{item.description}</dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        (product.specificationsLeft.length > 0 ||
          product.specificationsRight.length > 0) && (
          <section>
            <h2>{product.specificationsTabLabel}</h2>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:2rem">
              <div>
                {product.specificationsLeft.map((item) => (
                  <div>
                    <dt>{item.title}</dt>
                    <dd>{item.description}</dd>
                  </div>
                ))}
              </div>
              <div>
                {product.specificationsRight.map((item) => (
                  <div>
                    <dt>{item.title}</dt>
                    <dd>{item.description}</dd>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )
      }

      {product.tableData && product.tableData.length > 0 && (
        <section>
          {product.tableData.map((row) => (
            <div>
              <pre>{JSON.stringify(row, null, 2)}</pre>
            </div>
          ))}
        </section>
      )}

      {
        (product.blueprintFirst?.url || product.blueprintSecond?.url) && (
          <section>
            <h2>{product.blueprintsTabLabel}</h2>
            {product.blueprintFirst?.url && (
              <img
                src={product.blueprintFirst.url}
                alt={product.blueprintFirstAlt || ''}
                style="max-width:100%;height:auto"
              />
            )}
            {product.blueprintSecond?.url && (
              <img
                src={product.blueprintSecond.url}
                alt={product.blueprintSecondAlt || ''}
                style="max-width:100%;height:auto"
              />
            )}
          </section>
        )
      }

      {product.ctaLabel && (
        <a href={product.ctaUrl || '#'}>{product.ctaLabel}</a>
      )}
    </main>
  </body>
</html>
