---
import MainLayout from '@/layouts/MainLayout.astro';
import SafeBlocksRenderer from '@components/blocks/SafeBlocksRenderer.astro';
import CardBlogSupport from '@components/ui/cards/CardBlogSupport.astro';
import Bookmark from '@components/ui/buttons/Bookmark.astro';
import SocialShare from '@components/ui/buttons/SocialShare.astro';
import PostFeedback from '@components/ui/feedback/PostFeedback.astro';
import { capitalize, formatDate } from '@utils/utils';
import {
  getSupportArticleBySlug,
  getSupportArticles,
  getSupportPage,
  getTemplateForCategory,
} from '@lib/cms/support-resolver';
import type { SupportArticleViewModel } from '@lib/cms/support-models';
import { getRuntimeConfig } from '@lib/runtime/site-runtime';
import { SITE } from '@data/constants';
import { getCmsConfig } from '@lib/cms/config';
import fallbackAuthorImg from '@images/blog/jacob.avif';

export const prerender = false;

const { handle } = Astro.params;

if (!handle) {
  return Astro.redirect('/blogs/support/');
}

// ── Fetch runtime config ──
let runtime;
try {
  runtime = await getRuntimeConfig();
} catch {
  runtime = null;
}

const siteKey = runtime?.site?.key ?? 'store-us';
const locale = 'en';
const siteDomain = runtime?.site?.domain || SITE.url;
const cmsBaseUrl = getCmsConfig().baseUrl || '';

// ── Fetch article ──
const article: SupportArticleViewModel | null = await getSupportArticleBySlug(
  siteKey,
  locale,
  handle
);

if (!article) {
  return Astro.redirect('/404');
}

// ── Fetch support page for labels ──
const supportPage = await getSupportPage(siteKey, locale);

const template = getTemplateForCategory(article.category);

// ── SEO ──
const pageTitle = `${article.seo?.title || article.title} | ${SITE.title}`;
const metaDescription = article.seo?.description || article.excerpt;
const ogTitle = `${article.seo?.title || article.title} | ${siteDomain.replace(/^https?:\/\//, '')}`;

const canonicalUrl = `${siteDomain}/blogs/support/${article.slug}/`;
const cardImageUrl = article.cardImage?.url
  ? article.cardImage.url.startsWith('/')
    ? `${cmsBaseUrl}${article.cardImage.url}`
    : article.cardImage.url
  : undefined;

const structuredData =
  template === 'blog'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: article.title,
        description: article.excerpt,
        image: cardImageUrl,
        datePublished: article.displayDate || undefined,
        author: {
          '@type': 'Person',
          name: article.author,
        },
        publisher: {
          '@type': 'Organization',
          name: runtime?.brand?.name || SITE.title,
          logo: {
            '@type': 'ImageObject',
            url: `${siteDomain}/favicon.ico`,
          },
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalUrl,
        },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: article.title,
        description: metaDescription,
        image: cardImageUrl,
        author: {
          '@type': 'Person',
          name: article.author,
        },
        publisher: {
          '@type': 'Organization',
          name: runtime?.brand?.name || SITE.title,
          logo: {
            '@type': 'ImageObject',
            url: `${siteDomain}/favicon.ico`,
          },
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalUrl,
        },
      };

const authorImgSrc = article.authorImage?.url || fallbackAuthorImg.src;
const authorImgAlt = article.authorImage?.alt || article.authorImageAlt || '';
const displayDate = article.displayDate
  ? formatDate(new Date(article.displayDate))
  : '';
const readTimeStr = article.readTimeMinutes
  ? `${article.readTimeMinutes} min read`
  : '';

// ── Related articles ──
const allArticles = await getSupportArticles(siteKey, locale);
const relatedArticles = allArticles
  .filter(a => a.documentId !== article.documentId && a.category !== 'insight')
  .slice(0, 2);

const feedbackTitle = supportPage?.feedbackTitle || 'Was this post helpful?';
const feedbackYesLabel = supportPage?.feedbackYesLabel || 'Yes';
const feedbackNoLabel = supportPage?.feedbackNoLabel || 'No';
const relatedTitle = supportPage?.relatedTitle || 'Related articles';

const pageContentAvailability = { en: true, fr: true };
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={structuredData}
  pageContentAvailability={pageContentAvailability}
>
  {
    template === 'blog' && (
      <>
        <section class="mx-auto max-w-3xl px-4 pt-6 pb-12 sm:px-6 lg:px-8 lg:pt-10">
          <div class="max-w-2xl">
            <div class="mb-6 flex items-center justify-between">
              <div class="flex w-full gap-x-5 sm:items-center sm:gap-x-3">
                <div class="shrink-0">
                  <img
                    class="size-10 rounded-full sm:h-14 sm:w-14"
                    src={authorImgSrc}
                    alt={authorImgAlt}
                    draggable="false"
                  />
                </div>
                <div class="grow">
                  <div class="flex items-center justify-between gap-x-2">
                    <div>
                      <span class="font-bold text-neutral-700 dark:text-neutral-300">
                        {article.author}
                      </span>
                      <ul class="text-xs text-neutral-500">
                        <li class="relative inline-block pe-6 before:absolute before:end-2 before:top-1/2 before:size-1 before:-translate-y-1/2 before:rounded-full before:bg-neutral-300 last:pe-0 last-of-type:before:hidden dark:text-neutral-400 dark:before:bg-neutral-600">
                          {displayDate}
                        </li>
                        {readTimeStr && (
                          <li class="relative inline-block pe-6 before:absolute before:end-2 before:top-1/2 before:size-1 before:-translate-y-1/2 before:rounded-full before:bg-neutral-300 last:pe-0 last-of-type:before:hidden dark:text-neutral-400 dark:before:bg-neutral-600">
                            {readTimeStr}
                          </li>
                        )}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <h2 class="mb-3 text-2xl font-bold text-neutral-800 md:text-3xl dark:text-neutral-200">
              {article.title}
            </h2>

            {article.cardImage?.url && (
              <img
                class="mb-5 w-full rounded-xl object-cover md:mb-8"
                src={
                  typeof article.cardImage.url === 'string'
                    ? article.cardImage.url.startsWith('/')
                      ? `${cmsBaseUrl}${article.cardImage.url}`
                      : article.cardImage.url
                    : ''
                }
                alt={article.cardImage?.alt || article.cardImageAlt}
                draggable="false"
              />
            )}

            <SafeBlocksRenderer blocks={article.content} />

            <div class="mx-auto grid max-w-(--breakpoint-lg) gap-y-5 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
              <div class="flex flex-wrap gap-x-2 gap-y-1 sm:flex-nowrap sm:items-center sm:gap-y-0">
                {article.tags?.map((tag: string) => (
                  <span class="inline-flex items-center gap-x-1.5 rounded-lg bg-neutral-400/30 px-3 py-1.5 text-xs font-medium text-neutral-700 outline-hidden focus:outline-hidden focus-visible:ring-3 focus-visible:outline-hidden dark:bg-neutral-700/60 dark:text-neutral-300">
                    {capitalize(tag)}
                  </span>
                ))}
              </div>
              <div class="flex items-center justify-end gap-x-1.5">
                <Bookmark />
                <div class="mx-3 block h-4 border-e border-neutral-400 dark:border-neutral-500" />
                <div class="inline-flex">
                  <SocialShare pageTitle={article.title} />
                </div>
              </div>
            </div>
          </div>
          <PostFeedback
            title={feedbackTitle}
            firstChoice={feedbackYesLabel}
            secondChoice={feedbackNoLabel}
          />
        </section>

        {relatedArticles.length > 0 && (
          <section class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
            <div class="mb-10 max-w-2xl">
              <h2 class="text-2xl font-bold text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
                {relatedTitle}
              </h2>
            </div>

            <div class="grid grid-cols-2 gap-6">
              {relatedArticles.map(entry => (
                <CardBlogSupport article={entry} />
              ))}
            </div>
          </section>
        )}
      </>
    )
  }

  {
    template === 'insight' && (
      <section class="py-6 sm:py-8 lg:py-12">
        <div class="mx-auto max-w-(--breakpoint-xl) px-4 md:px-8">
          <div class="grid gap-8 md:grid-cols-2 lg:gap-12">
            <div>
              <div class="h-64 overflow-hidden rounded-lg shadow-lg md:h-auto">
                {article.cardImage?.url && (
                  <img
                    class="h-full w-full object-cover object-center"
                    src={
                      typeof article.cardImage.url === 'string'
                        ? article.cardImage.url.startsWith('/')
                          ? `${cmsBaseUrl}${article.cardImage.url}`
                          : article.cardImage.url
                        : ''
                    }
                    alt={article.cardImage?.alt || article.cardImageAlt}
                    draggable="false"
                  />
                )}
              </div>
              <div
                id="progress-mobile"
                class="fixed top-0 left-0 h-2 w-full bg-linear-to-r from-orange-400/30 to-orange-400 md:hidden"
              />
              <div id="pin" class="mt-10 hidden space-y-4 md:block">
                <div class="h-px w-full overflow-hidden bg-neutral-300 dark:bg-neutral-700">
                  <div
                    id="progress"
                    class="h-px w-full bg-linear-to-r from-orange-400/30 to-orange-400"
                  />
                </div>
                <p class="text-sm text-pretty text-neutral-500">
                  Table of Contents:
                </p>
                <div id="toc" class="">
                  <ul class="space-y-2 text-base text-pretty text-neutral-700 transition duration-300 dark:text-neutral-400" />
                </div>
              </div>
            </div>

            <div class="md:pt-8">
              <h1 class="mb-4 text-center text-2xl font-bold text-balance text-neutral-800 sm:text-3xl md:mb-6 md:text-left dark:text-neutral-200">
                {article.title}
              </h1>

              <SafeBlocksRenderer
                blocks={article.content}
                class="text-lg text-pretty text-neutral-700 dark:text-neutral-300"
              />
            </div>
          </div>
        </div>
      </section>
    )
  }
</MainLayout>

<style is:global>
  :root {
    --transition-cubic: cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  html {
    scroll-behavior: smooth;
  }

  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    font-weight: bold;
    margin-top: 2.5rem;
    scroll-margin-top: 3rem;
  }

  h2 {
    font-size: 1.5rem;
    line-height: 2rem;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.75rem;
  }

  h4 {
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  p {
    margin-top: 1.5rem;
  }

  #toc li {
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: all 300ms var(--transition-cubic);
  }

  #toc li.selected {
    opacity: 1;
  }

  #toc li svg {
    width: 0;
    height: 0;
    transition:
      height 400ms var(--transition-cubic),
      width 400ms var(--transition-cubic);
  }

  #toc li.selected svg {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.3rem;
  }
</style>

<script>
  const onScroll = (): void => {
    const articleEl = document.querySelector('article');
    if (!articleEl) return;

    const articleHeight = articleEl.offsetHeight;
    const articleOffsetTop = articleEl.offsetTop;

    const scrollTop = window.scrollY || document.documentElement.scrollTop;

    if (articleHeight && articleOffsetTop && scrollTop) {
      const progress =
        ((scrollTop - articleOffsetTop) /
          (articleHeight - window.innerHeight)) *
        100;

      const progressBar = document.getElementById('progress');
      const progressBarMobile = document.getElementById('progress-mobile');

      if (progressBar && progressBarMobile) {
        progressBar.style.width = `${progress}%`;
        progressBarMobile.style.width = `${progress}%`;
      }
    }
  };

  document.addEventListener('DOMContentLoaded', event => {
    window.onscroll = onScroll;

    const progressBar = document.getElementById('progress');
    const progressBarMobile = document.getElementById('progress-mobile');

    if (progressBar && progressBarMobile) {
      progressBar.style.width = '0%';
      progressBarMobile.style.width = '0%';
    }
  });
</script>
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.timeline({
    scrollTrigger: {
      scrub: 1,
      pin: true,
      trigger: '#pin',
      start: 'top 20%',
      endTrigger: 'footer',
      end: 'top bottom',
    },
  });

  const SVG_HTML_STRING =
    '<svg class="w-0 h-0 flex-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#fa5a15"><path stroke-linecap="round" stroke-linejoin="round" d="m12.75 15 3-3m0 0-3-3m3 3h-7.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"></svg>';

  function setActiveLinkById(id: string | null) {
    const listItems = document.querySelectorAll('#toc li');
    listItems.forEach(item => item.classList.remove('selected'));

    if (!id) return;

    const activeLink = document.querySelector(`#toc a[href="#${id}"]`);

    if (!activeLink) return;

    const listItem = activeLink.parentElement;
    listItem?.classList.add('selected');
  }

  document.addEventListener('DOMContentLoaded', function () {
    const articleEl: HTMLElement | null = document.querySelector('article');
    const tocList: HTMLElement | null = document.querySelector('#toc ul');

    const headings: NodeListOf<HTMLElement> | [] = articleEl
      ? articleEl.querySelectorAll('h1, h2, h3, h4, h5, h6')
      : [];

    headings.forEach((heading, i) => {
      if (heading instanceof HTMLElement) {
        const listItem = document.createElement('li');
        listItem.className = 'toc-level-' + heading.tagName.toLowerCase();

        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = SVG_HTML_STRING;

        const svg = tempDiv.firstChild;
        listItem.appendChild(svg as Node);

        const link = document.createElement('a');
        link.href = '#' + heading.id;
        link.textContent = heading.textContent;
        listItem.appendChild(link);

        tocList?.appendChild(listItem);

        gsap.timeline({
          scrollTrigger: {
            trigger: heading,
            start: 'top 20%',
            end: () =>
              `bottom top+=${i === headings.length - 1 ? 0 : (headings[i + 1] as HTMLElement).getBoundingClientRect().height}`,
            onEnter: () => setActiveLinkById(heading.id),
            onLeaveBack: () =>
              setActiveLinkById((headings[i - 1] as HTMLElement)?.id),
          },
        });
      }
    });
  });
</script>
