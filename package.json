{
  "name": "screwfast-template",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/generate-favicon.mjs && astro check && astro build && node process-html.mjs",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "preview": "astro preview",
    "preview:worker": "astro preview --host 127.0.0.1 --port 4321",
    "astro": "astro",
    "test:smoke:http": "node scripts/smoke.mjs",
    "test:smoke": "start-server-and-test preview:worker http-get://127.0.0.1:4321 test:smoke:http",
    "test:support-runtime": "node scripts/test-support-runtime.mjs",
    "test:support-live": "node scripts/test-support-live.mjs",
    "deploy": "pnpm build && wrangler deploy --config dist-out/server/wrangler.json",
    "test:cms": "node scripts/test-cms-integration.mjs",
    "test:cms-probe-contract": "node scripts/test-cms-probe-contract.mjs",
    "test:product": "node scripts/test-product-ssr.mjs",
    "test:brand-i18n": "node scripts/test-brand-i18n.mjs",
    "test:generic": "node scripts/test-generic-template.mjs",
    "test:global-runtime": "node scripts/test-global-runtime.mjs",
    "test:runtime-hygiene": "node scripts/test-runtime-hygiene.mjs",
    "test:theme-preservation": "node scripts/test-theme-preservation.mjs",
    "test:homepage-runtime": "node scripts/test-homepage-runtime.mjs",
    "test:homepage-media": "node scripts/test-homepage-media.mjs",
    "test:homepage-media-render": "node scripts/test-homepage-media-render.mjs",
    "test:page-map": "node scripts/test-page-template-map.mjs",
    "test:product-preservation": "node scripts/test-product-preservation.mjs",
    "test:product-live": "node scripts/test-product-live.mjs",
    "test:product-runtime-v2": "node scripts/test-product-runtime-v2.mjs",
    "worker:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run --config dist-out/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "clipboard": "^2.0.11",
    "globby": "^16.2.2",
    "gsap": "^3.15.0",
    "html-minifier-terser": "^7.2.0",
    "lenis": "^1.3.25",
    "preline": "^4.2.0",
    "sharp": "^0.35.3",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "astro-vtbot": "^3.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "start-server-and-test": "^3.0.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.119.0"
  }
}
