{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zerniqpro-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
}
